-- Every query below returns the same columns (an episode, its file status, its podcast and the
-- user's state, including its marks and its place in the queue), so a single mapper builds an EpisodeItem.
-- Missing state means NEW at position 0, outside the queue.
-- A nullable ":status" cannot be used: SQLDelight turns "= ?" into "IS ?" for null, which
-- PostgreSQL rejects. Hence the explicit ":filterByStatus" flag.

latestForUser:
SELECT d.id, d.podcast_id, d.title, d.description, d.published_at, d.duration_seconds,
       d.chapters_url, d.chapters_type, d.file_status,
       d.podcast_title, d.podcast_author, d.podcast_description, d.podcast_feed_url, d.podcast_artwork_url,
       d.podcast_website_url, d.podcast_language, d.podcast_refresh_status, d.podcast_refreshed_at,
       COALESCE(s.position_seconds, 0) AS position_seconds, COALESCE(s.status, 'NEW') AS status, COALESCE(s.kept, FALSE) AS kept,
       COALESCE(s.favorite, FALSE) AS favorite, s.rating,
       q.position AS queue_position
FROM episode_details d
JOIN subscriptions sub ON sub.podcast_id = d.podcast_id AND sub.user_id = :userId
LEFT JOIN playback_states s ON s.episode_id = d.id AND s.user_id = :userId
LEFT JOIN queue_items q ON q.episode_id = d.id AND q.user_id = :userId
WHERE :filterByStatus = FALSE OR COALESCE(s.status, 'NEW') = :status
ORDER BY d.published_at DESC, d.id DESC
LIMIT :limit OFFSET :offset;

countLatestForUser:
SELECT count(*)
FROM episodes e
JOIN subscriptions sub ON sub.podcast_id = e.podcast_id AND sub.user_id = :userId
LEFT JOIN playback_states s ON s.episode_id = e.id AND s.user_id = :userId
WHERE :filterByStatus = FALSE OR COALESCE(s.status, 'NEW') = :status;

-- Episodes being listened to, most recently played first.
resumeForUser:
SELECT d.id, d.podcast_id, d.title, d.description, d.published_at, d.duration_seconds,
       d.chapters_url, d.chapters_type, d.file_status,
       d.podcast_title, d.podcast_author, d.podcast_description, d.podcast_feed_url, d.podcast_artwork_url,
       d.podcast_website_url, d.podcast_language, d.podcast_refresh_status, d.podcast_refreshed_at,
       COALESCE(s.position_seconds, 0) AS position_seconds, COALESCE(s.status, 'NEW') AS status, COALESCE(s.kept, FALSE) AS kept,
       COALESCE(s.favorite, FALSE) AS favorite, s.rating,
       q.position AS queue_position
FROM episode_details d
JOIN playback_states s ON s.episode_id = d.id AND s.user_id = :userId
LEFT JOIN queue_items q ON q.episode_id = d.id AND q.user_id = :userId
WHERE s.status = 'IN_PROGRESS'
ORDER BY s.updated_at DESC, d.id DESC
LIMIT :limit;

episodeForUser:
SELECT d.id, d.podcast_id, d.title, d.description, d.published_at, d.duration_seconds,
       d.chapters_url, d.chapters_type, d.file_status,
       d.podcast_title, d.podcast_author, d.podcast_description, d.podcast_feed_url, d.podcast_artwork_url,
       d.podcast_website_url, d.podcast_language, d.podcast_refresh_status, d.podcast_refreshed_at,
       COALESCE(s.position_seconds, 0) AS position_seconds, COALESCE(s.status, 'NEW') AS status, COALESCE(s.kept, FALSE) AS kept,
       COALESCE(s.favorite, FALSE) AS favorite, s.rating,
       q.position AS queue_position
FROM episode_details d
LEFT JOIN playback_states s ON s.episode_id = d.id AND s.user_id = :userId
LEFT JOIN queue_items q ON q.episode_id = d.id AND q.user_id = :userId
WHERE d.id = :id;

podcastEpisodesForUser:
SELECT d.id, d.podcast_id, d.title, d.description, d.published_at, d.duration_seconds,
       d.chapters_url, d.chapters_type, d.file_status,
       d.podcast_title, d.podcast_author, d.podcast_description, d.podcast_feed_url, d.podcast_artwork_url,
       d.podcast_website_url, d.podcast_language, d.podcast_refresh_status, d.podcast_refreshed_at,
       COALESCE(s.position_seconds, 0) AS position_seconds, COALESCE(s.status, 'NEW') AS status, COALESCE(s.kept, FALSE) AS kept,
       COALESCE(s.favorite, FALSE) AS favorite, s.rating,
       q.position AS queue_position
FROM episode_details d
LEFT JOIN playback_states s ON s.episode_id = d.id AND s.user_id = :userId
LEFT JOIN queue_items q ON q.episode_id = d.id AND q.user_id = :userId
WHERE d.podcast_id = :podcastId
ORDER BY d.published_at DESC, d.id DESC
LIMIT :limit OFFSET :offset;

-- The user's queue, in order (Queue.sq changes it).
queueForUser:
SELECT d.id, d.podcast_id, d.title, d.description, d.published_at, d.duration_seconds,
       d.chapters_url, d.chapters_type, d.file_status,
       d.podcast_title, d.podcast_author, d.podcast_description, d.podcast_feed_url, d.podcast_artwork_url,
       d.podcast_website_url, d.podcast_language, d.podcast_refresh_status, d.podcast_refreshed_at,
       COALESCE(s.position_seconds, 0) AS position_seconds, COALESCE(s.status, 'NEW') AS status, COALESCE(s.kept, FALSE) AS kept,
       COALESCE(s.favorite, FALSE) AS favorite, s.rating,
       q.position AS queue_position
FROM queue_items q
JOIN episode_details d ON d.id = q.episode_id
LEFT JOIN playback_states s ON s.episode_id = d.id AND s.user_id = :userId
WHERE q.user_id = :userId
ORDER BY q.position, q.added_at;

saveProgress:
INSERT INTO playback_states(user_id, episode_id, position_seconds, status)
VALUES (:userId, :episodeId, :positionSeconds, :status)
ON CONFLICT (user_id, episode_id) DO UPDATE
SET position_seconds = excluded.position_seconds, status = excluded.status, updated_at = now();

-- Back to NEW; the row stays so that "kept" is not lost.
markUnplayed:
UPDATE playback_states
SET position_seconds = 0, status = 'NEW', updated_at = now()
WHERE user_id = :userId AND episode_id = :episodeId;

setKept:
INSERT INTO playback_states(user_id, episode_id, status, kept)
VALUES (:userId, :episodeId, 'NEW', :kept)
ON CONFLICT (user_id, episode_id) DO UPDATE
SET kept = excluded.kept;

setFavorite:
INSERT INTO playback_states(user_id, episode_id, status, favorite)
VALUES (:userId, :episodeId, 'NEW', :favorite)
ON CONFLICT (user_id, episode_id) DO UPDATE
SET favorite = excluded.favorite;

-- A null rating clears it.
setRating:
INSERT INTO playback_states(user_id, episode_id, status, rating)
VALUES (:userId, :episodeId, 'NEW', :rating)
ON CONFLICT (user_id, episode_id) DO UPDATE
SET rating = excluded.rating;

-- The episodes of a static playlist, in its order, as [viewerId] sees them.
staticPlaylistEpisodes:
SELECT d.id, d.podcast_id, d.title, d.description, d.published_at, d.duration_seconds,
       d.chapters_url, d.chapters_type, d.file_status,
       d.podcast_title, d.podcast_author, d.podcast_description, d.podcast_feed_url, d.podcast_artwork_url,
       d.podcast_website_url, d.podcast_language, d.podcast_refresh_status, d.podcast_refreshed_at,
       COALESCE(s.position_seconds, 0) AS position_seconds, COALESCE(s.status, 'NEW') AS status, COALESCE(s.kept, FALSE) AS kept,
       COALESCE(s.favorite, FALSE) AS favorite, s.rating,
       q.position AS queue_position
FROM playlist_items i
JOIN episode_details d ON d.id = i.episode_id
LEFT JOIN playback_states s ON s.episode_id = d.id AND s.user_id = :viewerId
LEFT JOIN queue_items q ON q.episode_id = d.id AND q.user_id = :viewerId
WHERE i.playlist_id = :playlistId
ORDER BY i.position, i.added_at;

-- A dynamic playlist (ADR 0010): its owner's subscriptions, filtered on the owner's marks, as
-- [viewerId] sees them. :keywordPattern is a case-insensitive regular expression ('' = any);
-- RANDOM orders by a hash of the episode id and :seed, so the order holds until the next shuffle.
dynamicPlaylistEpisodes:
SELECT d.id, d.podcast_id, d.title, d.description, d.published_at, d.duration_seconds,
       d.chapters_url, d.chapters_type, d.file_status,
       d.podcast_title, d.podcast_author, d.podcast_description, d.podcast_feed_url, d.podcast_artwork_url,
       d.podcast_website_url, d.podcast_language, d.podcast_refresh_status, d.podcast_refreshed_at,
       COALESCE(s.position_seconds, 0) AS position_seconds, COALESCE(s.status, 'NEW') AS status, COALESCE(s.kept, FALSE) AS kept,
       COALESCE(s.favorite, FALSE) AS favorite, s.rating,
       q.position AS queue_position
FROM episode_details d
JOIN subscriptions sub ON sub.podcast_id = d.podcast_id AND sub.user_id = :ownerId
LEFT JOIN playback_states o ON o.episode_id = d.id AND o.user_id = :ownerId
LEFT JOIN playback_states s ON s.episode_id = d.id AND s.user_id = :viewerId
LEFT JOIN queue_items q ON q.episode_id = d.id AND q.user_id = :viewerId
WHERE (:keywordPattern = '' OR d.title ~* :keywordPattern OR d.description ~* :keywordPattern OR d.podcast_title ~* :keywordPattern)
  AND (:favoritesOnly = FALSE OR COALESCE(o.favorite, FALSE))
  AND COALESCE(o.rating, 0) >= :minRating
  AND (:unplayedOnly = FALSE OR COALESCE(o.status, 'NEW') <> 'PLAYED')
ORDER BY
  CASE WHEN :sortOrder = 'RANDOM' THEN (d.id * :seed) % 1000003 ELSE 0 END,
  CASE WHEN :sortOrder = 'OLDEST' THEN d.published_at END ASC,
  d.published_at DESC, d.id DESC
LIMIT :limit;

-- The search of ADR 0012, among the user's subscriptions. :pattern holds one lookahead per word
-- ("^(?=.*kotlin)(?=.*ktor)"), empty for none; :podcastId 0, :tag '' and the flags mean "any".
searchForUser:
SELECT d.id, d.podcast_id, d.title, d.description, d.published_at, d.duration_seconds,
       d.chapters_url, d.chapters_type, d.file_status,
       d.podcast_title, d.podcast_author, d.podcast_description, d.podcast_feed_url, d.podcast_artwork_url,
       d.podcast_website_url, d.podcast_language, d.podcast_refresh_status, d.podcast_refreshed_at,
       COALESCE(s.position_seconds, 0) AS position_seconds, COALESCE(s.status, 'NEW') AS status, COALESCE(s.kept, FALSE) AS kept,
       COALESCE(s.favorite, FALSE) AS favorite, s.rating,
       q.position AS queue_position
FROM episode_details d
JOIN subscriptions sub ON sub.podcast_id = d.podcast_id AND sub.user_id = :userId
LEFT JOIN playback_states s ON s.episode_id = d.id AND s.user_id = :userId
LEFT JOIN queue_items q ON q.episode_id = d.id AND q.user_id = :userId
WHERE (:pattern = '' OR d.title || ' ' || COALESCE(d.description, '') || ' ' || d.podcast_title ~* :pattern)
  AND (:filterByStatus = FALSE OR COALESCE(s.status, 'NEW') = :status)
  AND (:favoritesOnly = FALSE OR COALESCE(s.favorite, FALSE))
  AND COALESCE(s.rating, 0) >= :minRating
  AND (:filterFrom = FALSE OR d.published_at >= :fromTime)
  AND (:filterTo = FALSE OR d.published_at < :toTime)
  AND (d.podcast_id = :podcastId OR :podcastId = 0)
  AND (:tag = '' OR EXISTS (SELECT 1 FROM subscription_tags t WHERE t.subscription_id = sub.id AND lower(t.tag) = lower(:tag)))
ORDER BY d.published_at DESC, d.id DESC
LIMIT :limit OFFSET :offset;

countSearchForUser:
SELECT count(*)
FROM episode_details d
JOIN subscriptions sub ON sub.podcast_id = d.podcast_id AND sub.user_id = :userId
LEFT JOIN playback_states s ON s.episode_id = d.id AND s.user_id = :userId
WHERE (:pattern = '' OR d.title || ' ' || COALESCE(d.description, '') || ' ' || d.podcast_title ~* :pattern)
  AND (:filterByStatus = FALSE OR COALESCE(s.status, 'NEW') = :status)
  AND (:favoritesOnly = FALSE OR COALESCE(s.favorite, FALSE))
  AND COALESCE(s.rating, 0) >= :minRating
  AND (:filterFrom = FALSE OR d.published_at >= :fromTime)
  AND (:filterTo = FALSE OR d.published_at < :toTime)
  AND (d.podcast_id = :podcastId OR :podcastId = 0)
  AND (:tag = '' OR EXISTS (SELECT 1 FROM subscription_tags t WHERE t.subscription_id = sub.id AND lower(t.tag) = lower(:tag)));
