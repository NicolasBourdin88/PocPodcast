insertUser:
INSERT INTO users(username, display_name, password_hash, role)
VALUES (:username, :displayName, :passwordHash, :role)
RETURNING id;

userByUsername:
SELECT id, username, display_name, password_hash, role
FROM users
WHERE username = :username;

userById:
SELECT id, username, display_name, password_hash, role
FROM users
WHERE id = :id;

countUsers:
SELECT count(*) FROM users;
