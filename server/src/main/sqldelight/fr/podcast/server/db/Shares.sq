-- Shares between users (ADR 0005, 0009). Same columns for every share query, so that one mapper
-- builds a share with its owner and grantee.

shareById:
SELECT s.id, s.resource_type, s.resource_id, s.permission, s.message, s.created_at,
       o.id AS owner_id, o.username AS owner_username, o.display_name AS owner_display_name, o.role AS owner_role,
       g.id AS grantee_id, g.username AS grantee_username, g.display_name AS grantee_display_name, g.role AS grantee_role
FROM shares s
JOIN users o ON o.id = s.owner_id
JOIN users g ON g.id = s.grantee_id
WHERE s.id = :id;

-- Whom a resource is shared with, by name.
sharesOfResource:
SELECT s.id, s.resource_type, s.resource_id, s.permission, s.message, s.created_at,
       o.id AS owner_id, o.username AS owner_username, o.display_name AS owner_display_name, o.role AS owner_role,
       g.id AS grantee_id, g.username AS grantee_username, g.display_name AS grantee_display_name, g.role AS grantee_role
FROM shares s
JOIN users o ON o.id = s.owner_id
JOIN users g ON g.id = s.grantee_id
WHERE s.resource_type = :resourceType AND s.resource_id = :resourceId
ORDER BY lower(g.display_name), g.id;

-- What others share with a user, most recent first.
sharesReceived:
SELECT s.id, s.resource_type, s.resource_id, s.permission, s.message, s.created_at,
       o.id AS owner_id, o.username AS owner_username, o.display_name AS owner_display_name, o.role AS owner_role,
       g.id AS grantee_id, g.username AS grantee_username, g.display_name AS grantee_display_name, g.role AS grantee_role
FROM shares s
JOIN users o ON o.id = s.owner_id
JOIN users g ON g.id = s.grantee_id
WHERE s.grantee_id = :granteeId
ORDER BY s.created_at DESC, s.id DESC;

-- The permission :granteeId has on a resource (a subscription has one owner: one row at most).
permissionOf:
SELECT permission FROM shares
WHERE resource_type = :resourceType AND resource_id = :resourceId AND grantee_id = :granteeId;

-- Shares again with a new permission and message, or creates the share.
upsertShare:
INSERT INTO shares(resource_type, resource_id, owner_id, grantee_id, permission, message)
VALUES (:resourceType, :resourceId, :ownerId, :granteeId, :permission, :message)
ON CONFLICT (resource_type, resource_id, owner_id, grantee_id)
DO UPDATE SET permission = excluded.permission, message = excluded.message
RETURNING id;

updatePermission:
UPDATE shares SET permission = :permission WHERE id = :id;

deleteShare:
DELETE FROM shares WHERE id = :id;

-- A shared resource disappears (unsubscription).
deleteSharesOfResource:
DELETE FROM shares WHERE resource_type = :resourceType AND resource_id = :resourceId;

-- A podcast disappears: the recommendations of its episodes go too.
deleteEpisodeSharesOfPodcast:
DELETE FROM shares
WHERE resource_type = 'EPISODE' AND resource_id IN (SELECT id FROM episodes WHERE podcast_id = :podcastId);
