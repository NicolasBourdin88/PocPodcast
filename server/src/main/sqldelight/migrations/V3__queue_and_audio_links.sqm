-- Étape 5 : file d'attente de chaque utilisateur et liens audio signés.
-- Voir docs/api/modele-de-donnees.md et l'ADR 0008.

-- "Up next": the episodes a user wants to hear after the current one, in order (0 first).
CREATE TABLE queue_items (
    user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    episode_id BIGINT NOT NULL REFERENCES episodes(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    added_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    PRIMARY KEY (user_id, episode_id)
);

CREATE INDEX queue_items_by_position ON queue_items(user_id, position);

-- Keys generated by the server on its first start (signature of the audio links).
CREATE TABLE server_secrets (
    name TEXT PRIMARY KEY,
    value BYTEA NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
