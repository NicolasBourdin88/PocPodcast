-- Étape 6 : comptes (mot de passe, appareils) et partages entre utilisateurs.
-- Voir docs/api/modele-de-donnees.md et l'ADR 0009.

-- Incremented when the password changes: the sessions opened before become invalid.
ALTER TABLE users ADD COLUMN credentials_version INTEGER NOT NULL DEFAULT 0;

-- What a user shares with another one (ADR 0005): a subscription or an episode now, a playlist
-- at step 7. resource_id is the id of the row of resource_type, which belongs to owner_id.
CREATE TABLE shares (
    id BIGSERIAL PRIMARY KEY,
    resource_type TEXT NOT NULL CHECK (resource_type IN ('SUBSCRIPTION', 'EPISODE', 'PLAYLIST')),
    resource_id BIGINT NOT NULL,
    owner_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    grantee_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    permission TEXT NOT NULL CHECK (permission IN ('READ', 'WRITE')),
    message TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    UNIQUE (resource_type, resource_id, owner_id, grantee_id),
    CHECK (owner_id <> grantee_id)
);

CREATE INDEX shares_by_grantee ON shares(grantee_id, created_at);
