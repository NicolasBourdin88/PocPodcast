-- Étape 3 : comptes, catalogue mutualisé, abonnements et état d'écoute par utilisateur.
-- Modèle complet et tables des étapes suivantes : docs/api/modele-de-donnees.md

CREATE TABLE users (
    id BIGSERIAL PRIMARY KEY,
    username TEXT NOT NULL UNIQUE,
    display_name TEXT NOT NULL,
    password_hash TEXT NOT NULL,
    role TEXT NOT NULL DEFAULT 'USER' CHECK (role IN ('USER', 'ADMIN')),
    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- Opaque per-device tokens; only their SHA-256 is stored (ADR 0005).
CREATE TABLE api_tokens (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    token_hash TEXT NOT NULL UNIQUE,
    device_name TEXT NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    last_used_at TIMESTAMPTZ,
    revoked_at TIMESTAMPTZ
);

-- Thin client sessions (Ktor SessionStorage).
CREATE TABLE http_sessions (
    id TEXT PRIMARY KEY,
    value TEXT NOT NULL,
    expires_at TIMESTAMPTZ NOT NULL
);

CREATE TABLE podcasts (
    id BIGSERIAL PRIMARY KEY,
    feed_url TEXT NOT NULL UNIQUE,
    title TEXT NOT NULL,
    author TEXT NOT NULL DEFAULT '',
    description TEXT NOT NULL DEFAULT '',
    artwork_url TEXT,
    website_url TEXT,
    last_refreshed_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE TABLE episodes (
    id BIGSERIAL PRIMARY KEY,
    podcast_id BIGINT NOT NULL REFERENCES podcasts(id) ON DELETE CASCADE,
    guid TEXT NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    published_at TIMESTAMPTZ NOT NULL,
    duration_seconds INTEGER NOT NULL CHECK (duration_seconds >= 0),
    audio_url TEXT NOT NULL,
    UNIQUE (podcast_id, guid)
);

CREATE INDEX episodes_by_date ON episodes (published_at DESC, id DESC);

CREATE TABLE subscriptions (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    podcast_id BIGINT NOT NULL REFERENCES podcasts(id) ON DELETE CASCADE,
    note TEXT,
    subscribed_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    UNIQUE (user_id, podcast_id)
);

-- No row means NEW at position 0.
CREATE TABLE playback_states (
    user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    episode_id BIGINT NOT NULL REFERENCES episodes(id) ON DELETE CASCADE,
    position_seconds INTEGER NOT NULL DEFAULT 0 CHECK (position_seconds >= 0),
    status TEXT NOT NULL CHECK (status IN ('NEW', 'IN_PROGRESS', 'PLAYED')),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    PRIMARY KEY (user_id, episode_id)
);

-- Episodes with their podcast, the base of every episode query.
CREATE VIEW episode_details AS
SELECT e.id, e.podcast_id, e.title, e.description, e.published_at, e.duration_seconds, e.audio_url,
       p.title AS podcast_title, p.author AS podcast_author, p.description AS podcast_description,
       p.feed_url AS podcast_feed_url, p.artwork_url AS podcast_artwork_url
FROM episodes e
JOIN podcasts p ON p.id = e.podcast_id;
